#!/usr/bin/env python3
"""One-shot overlap check for ce-babysit-pr's stale-PR intake.

Answers "did the base move under this PR's paths since it branched off" from
freshly fetched refs:

  intake-overlap --repo-dir DIR --repo HOST/OWNER/REPO --remote NAME
                 --base BRANCH --pr N [--head-remote NAME]

Fetches the exact base bookmark and the PR's actual head bookmark with JJ.
GitHub identifies the PR head; the fetched head must match its full OID.
Compares both tips to their common ancestor. Overlap kinds:

  same-path       a base change (either rename name) is a PR path (either name)
  directory-gone  a PR path's ancestor directory existed at the merge-base and
                  is absent at the base tip (nearest such ancestor reported)
  sibling         a base change sits in the same non-root directory as a PR path

Prints one JSON object. "overlap" is true, false, or "unknown" when the question
cannot be answered (fetch failure, no merge-base); unknown sets "error" and still
exits 0. Only usage errors exit non-zero.
"""
import argparse
import json
import os
import posixpath
import re
import subprocess
import sys

FETCH_TIMEOUT_SECONDS = 300
READ_TIMEOUT_SECONDS = 120

_BAD_BRANCH = re.compile(r"[\x00-\x20\x7f~^:?*\[\\]|\.\.|@\{|//|/\.|\.lock$|^/|/$|\.$")
_OID = re.compile(r"[0-9a-f]{40}(?:[0-9a-f]{24})?")


class IntakeError(Exception):
    pass


def run(repo_dir, cmd, *, timeout=READ_TIMEOUT_SECONDS, env=None):
    env = dict(os.environ if env is None else env, GIT_TERMINAL_PROMPT="0",
               GH_PROMPT_DISABLED="1", NO_COLOR="1")
    env.pop("CLICOLOR_FORCE", None)
    env.pop("GH_FORCE_TTY", None)
    try:
        r = subprocess.run(
            cmd,
            cwd=repo_dir,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise IntakeError(f"{cmd[0]} timed out after {timeout}s") from None
    except OSError as e:
        raise IntakeError(f"could not run {cmd[0]}: {e}") from e
    if r.returncode != 0:
        err = r.stderr.decode("utf-8", errors="replace").strip()
        raise IntakeError(f"{cmd[0]} failed ({r.returncode}): {err}")
    return r.stdout.decode("utf-8")


def jj(repo_dir, *args, timeout=READ_TIMEOUT_SECONDS):
    env = os.environ.copy()
    for key in ("GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE"):
        env.pop(key, None)
    return run(repo_dir, ["jj", "--ignore-working-copy", "--no-pager", "--color=never",
                          *args], timeout=timeout, env=env)


def exact(name):
    return "exact:" + json.dumps(name, ensure_ascii=False)


def fetch_bookmark(repo_dir, remote, bookmark):
    jj(repo_dir, "git", "fetch", "--config", "git.abandon-unreachable-commits=false",
       "--remote", exact(remote), "--branch", exact(bookmark),
       timeout=FETCH_TIMEOUT_SECONDS)
    revset = f"remote_bookmarks({exact(bookmark)}, remote={exact(remote)})"
    oid = jj(repo_dir, "log", "--no-graph", "-r", revset,
             "-T", 'commit_id ++ "\n"').strip()
    if not _OID.fullmatch(oid):
        raise IntakeError(f"could not resolve exact fetched bookmark {bookmark}@{remote}")
    return oid


def fetch(repo_dir, repo, remote, base, pr, head_remote):
    # The caller verifies the URLs of the supplied remotes against these PR
    # repositories; an exact SHA comparison also catches head movement.
    parts = repo.split("/")
    host = parts[0] if len(parts) == 3 else "github.com"
    owner, name = parts[-2:]
    git_dir = jj(repo_dir, "git", "root").strip()
    env = dict(os.environ, GIT_DIR=git_dir)
    info = json.loads(run(repo_dir, ["gh", "api", "--hostname", host,
                                     f"repos/{owner}/{name}/pulls/{pr}"], env=env))
    base_ref, head_ref = info["base"], info["head"]
    if (base_ref["ref"] != base
            or base_ref["repo"]["full_name"].casefold() != f"{owner}/{name}".casefold()):
        raise IntakeError("PR base repository or branch changed during intake")
    head_branch, expected_oid = head_ref["ref"], head_ref["sha"]
    if not head_branch or _BAD_BRANCH.search(head_branch) or not _OID.fullmatch(expected_oid):
        raise IntakeError("PR head did not provide an exact valid branch and OID")
    base_oid = fetch_bookmark(repo_dir, remote, base)
    if head_ref.get("repo") and head_ref["repo"]["id"] == base_ref["repo"]["id"]:
        head_remote = remote
    if head_remote and head_ref.get("repo"):
        head_oid = fetch_bookmark(repo_dir, head_remote, head_branch)
        if head_oid != expected_oid:
            raise IntakeError("fetched head bookmark differs from the current PR head")
    else:
        # A fork may be gone or have no configured remote. Use the exact
        # GitHub-proven PR object only if it is already present, never a local
        # branch or another ref as a substitute.
        try:
            head_oid = jj(repo_dir, "log", "--no-graph", "-r", expected_oid,
                          "-T", "commit_id").strip()
        except IntakeError as e:
            raise IntakeError("no verified head remote and exact PR head object unavailable") from e
        if head_oid != expected_oid:
            raise IntakeError("exact PR head object unavailable")
    return base_oid, head_oid


def merge_base(repo_dir, a, b):
    common = jj(repo_dir, "log", "--no-graph", "-r",
                f"heads(::{a} & ::{b}) ~ root()", "-T", 'commit_id ++ "\n"').splitlines()
    if len(common) != 1 or not _OID.fullmatch(common[0]):
        raise IntakeError("no unique common ancestor for the exact base and PR head")
    return common[0]


def changes(repo_dir, a, b):
    """[(status, old, new)] for the exact JJ tree comparison."""
    out = jj(repo_dir, "diff", "--from", a, "--to", b, "-T",
             'json({"status" => status, "old" => source.path(), "new" => target.path(), '
             '"old_type" => source.file_type(), "new_type" => target.file_type()}) ++ "\n"')
    result = []
    for line in out.split("\n"):
        if not line:
            continue
        entry = json.loads(line)
        status = entry["status"]
        if status == "removed":
            status = "deleted"
        elif status == "modified" and entry["old_type"] != entry["new_type"]:
            status = "type-changed"
        result.append((status, entry["old"], entry["new"]))
    return result


def directories(repo_dir, commit):
    out = jj(repo_dir, "file", "list", "-r", commit, "-T", 'json(path) ++ "\n"')
    return {d for line in out.split("\n") if line for d in ancestors(json.loads(line))}


def ancestors(path):
    parent = posixpath.dirname(path)
    while parent:
        yield parent
        parent = posixpath.dirname(parent)


def overlap_reasons(pr_changes, base_changes, dirs_at_mb, dirs_at_base):
    pr_paths = sorted({p for _, old, new in pr_changes for p in (old, new)})

    by_path = {}
    by_parent = {}
    for change in base_changes:
        _, old, new = change
        for name in {old, new}:
            by_path.setdefault(name, []).append(change)
            parent = posixpath.dirname(name)
            if parent:
                by_parent.setdefault(parent, []).append(change)

    renamed_from = [old for status, old, _ in base_changes if status == "renamed"]

    reasons = set()
    for p in pr_paths:
        same = by_path.get(p, [])
        for status, _, new in same:
            reasons.add(("same-path", p, new, status))
        parent = posixpath.dirname(p)
        for change in by_parent.get(parent, []) if parent else []:
            if change not in same:
                status, _, new = change
                reasons.add(("sibling", p, new, status))
        for d in ancestors(p):
            if d in dirs_at_mb and d not in dirs_at_base:
                moved = any(old.startswith(d + "/") for old in renamed_from)
                reasons.add(("directory-gone", p, d, "renamed" if moved else "deleted"))
                break

    return [
        {"kind": k, "pr_path": p, "base_path": b, "base_status": s}
        for k, p, b, s in sorted(reasons)
    ]


def assess(repo_dir, repo, remote, base, pr, head_remote=None):
    result = {
        "base_oid": None,
        "head_oid": None,
        "merge_base": None,
        "overlap": "unknown",
        "reasons": [],
        "error": None,
    }
    try:
        base_oid, head_oid = fetch(repo_dir, repo, remote, base, pr, head_remote)
        result.update(base_oid=base_oid, head_oid=head_oid)

        mb = merge_base(repo_dir, base_oid, head_oid)
        result["merge_base"] = mb

        if mb == base_oid:
            result["overlap"] = False
            return result

        reasons = overlap_reasons(
            changes(repo_dir, mb, head_oid),
            changes(repo_dir, mb, base_oid),
            directories(repo_dir, mb),
            directories(repo_dir, base_oid),
        )
        result["reasons"] = reasons
        result["overlap"] = bool(reasons)
        return result
    except (IntakeError, KeyError, TypeError, ValueError) as e:
        result["error"] = str(e)
        return result


def main():
    p = argparse.ArgumentParser(prog="intake-overlap")
    p.add_argument("--repo-dir", required=True)
    p.add_argument("--repo", required=True)
    p.add_argument("--remote", required=True)
    p.add_argument("--head-remote")
    p.add_argument("--base", required=True)
    p.add_argument("--pr", type=int, required=True)
    args = p.parse_args()

    if args.pr <= 0:
        p.error("--pr must be a positive integer")
    if not re.fullmatch(r"(?:[\w.-]+/)?[\w.-]+/[\w.-]+", args.repo):
        p.error("--repo must be [HOST/]OWNER/REPO")
    if not args.remote or args.remote.startswith("-") or (args.head_remote or "").startswith("-"):
        p.error("remotes must be configured JJ remote names")
    if not args.base or args.base.startswith("-") or _BAD_BRANCH.search(args.base):
        p.error("--base must be a valid branch name")
    if not os.path.isdir(args.repo_dir):
        p.error("--repo-dir must be an existing directory")

    repo_dir = os.path.realpath(args.repo_dir)
    try:
        if not os.path.samefile(repo_dir, jj(repo_dir, "workspace", "root").strip()):
            p.error("--repo-dir must be the workspace root")
    except (IntakeError, OSError) as e:
        p.error(str(e))
    print(json.dumps(assess(repo_dir, args.repo, args.remote, args.base, args.pr, args.head_remote)))


if __name__ == "__main__":
    main()
