#!/usr/bin/env python3
"""One-shot overlap check for ce-babysit-pr's stale-PR intake.

Answers "did the base move under this PR's paths since it branched off" from
freshly fetched refs:

  intake-overlap --repo-dir DIR --remote NAME --base BRANCH --pr N

Fetches exact base and PR-head remote bookmarks with JJ,
takes their unique common ancestor, and compares the PR's changed paths with the base's
changes since then. Overlap kinds:

  same-path       a base change (either rename name) is a PR path (either name)
  directory-gone  a PR path's ancestor directory existed at the merge-base and
                  is absent at the base tip (nearest such ancestor reported)
  sibling         a base change sits in the same non-root directory as a PR path

Prints one JSON object. "overlap" is true, false, or "unknown" when the question
cannot be answered (fetch failure, no merge-base); unknown sets "error" and still
exits 0. Only usage errors exit non-zero.
"""
import argparse
import json
import os
import posixpath
import re
import subprocess
import sys

FETCH_TIMEOUT_SECONDS = 300
GIT_TIMEOUT_SECONDS = 120

STATUS_NAMES = {
    "A": "added",
    "C": "copied",
    "D": "deleted",
    "M": "modified",
    "R": "renamed",
    "T": "type-changed",
}

_BAD_BRANCH = re.compile(r"[\x00-\x20\x7f~^:?*\[\\]|\.\.|@\{|//|/\.|\.lock$|^/|/$|\.$")


class GitError(Exception):
    pass


def jj(repo_dir, *args, timeout=GIT_TIMEOUT_SECONDS, check=True):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    try:
        r = subprocess.run(
            ["jj", "--no-pager", "--color", "never", "--ignore-working-copy", *args],
            cwd=os.path.abspath(repo_dir),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise GitError(f"jj {args[0]} timed out after {timeout}s")
    except OSError as e:
        raise GitError(f"could not run jj: {e}")
    out = r.stdout.decode("utf-8", errors="replace")
    if check and r.returncode != 0:
        err = r.stderr.decode("utf-8", errors="replace").strip()
        raise GitError(f"jj {args[0]} failed ({r.returncode}): {err}")
    return r.returncode, out


def fetch(repo_dir, remote, base, pr, extra=()):
    """Fetch exact base/head bookmarks, never substitute a same-named fork branch."""
    root = os.path.abspath(repo_dir)
    env = dict(os.environ, GIT_DIR=jj(root, "git", "root")[1].strip())
    remotes = [line.split() for line in jj(root, "git", "remote", "list")[1].splitlines()]
    base_urls = [fields[1] for fields in remotes if len(fields) == 2 and fields[0] == remote]
    if len(base_urls) != 1:
        raise GitError("base remote must be one verified named remote")
    base_match = re.search(r"(?:https?://|ssh://(?:[^@/]+@)?|[^@]+@)([^/:]+)[:/]([^/]+)/([^/]+?)(?:\.git)?/?$", base_urls[0])
    if not base_match:
        raise GitError("cannot resolve base remote's GitHub host/repository")
    selector = "/".join(base_match.groups())
    r = subprocess.run(["gh", "pr", "view", str(pr), "--repo", selector, "--json",
                        "headRefName,headRefOid,headRepository,headRepositoryOwner"],
                       cwd=root, env=env, capture_output=True, text=True,
                       timeout=GIT_TIMEOUT_SECONDS)
    if r.returncode:
        raise GitError("PR lookup failed: " + r.stderr.strip())
    data = json.loads(r.stdout)
    branch, expected = data["headRefName"], data["headRefOid"]
    owner, name = data["headRepositoryOwner"]["login"], data["headRepository"]["name"]
    if not re.fullmatch(r"[0-9a-fA-F]{40}|[0-9a-fA-F]{64}", expected):
        raise GitError("invalid authoritative PR head OID")
    matches = []
    for fields in remotes:
        candidate = re.search(r"(?:https?://|ssh://(?:[^@/]+@)?|[^@]+@)([^/:]+)[:/]([^/]+)/([^/]+?)(?:\.git)?/?$", fields[1]) if len(fields) == 2 else None
        if candidate and tuple(x.lower() for x in candidate.groups()) == (
                base_match.group(1).lower(), owner.lower(), name.lower()):
            matches.append(fields[0])
    if len(matches) != 1:
        raise GitError("configure one unambiguous named PR-head remote before assessment")
    head_remote = matches[0]
    for rem, branch_name in ((remote, base), (head_remote, branch)):
        jj(root, "git", "fetch", "--remote", "exact:" + rem,
            "--branch", "exact:" + branch_name, timeout=FETCH_TIMEOUT_SECONDS)
    def resolve(branch_name, rem):
        rev = "remote_bookmarks(exact:" + json.dumps(branch_name) + ", exact:" + json.dumps(rem) + ")"
        lines = jj(root, "log", "--no-graph", "-r", rev,
                    "-T", 'commit_id ++ "\\n"')[1].splitlines()
        if len(lines) != 1 or not re.fullmatch(r"[0-9a-fA-F]{40}|[0-9a-fA-F]{64}", lines[0]):
            raise GitError("exact remote bookmark did not resolve uniquely")
        return lines[0]
    base_oid, head_oid = resolve(base, remote), resolve(branch, head_remote)
    if head_oid != expected:
        raise GitError("PR head moved during fetch; reassess")
    return base_oid, head_oid


def merge_base(repo_dir, a, b):
    code, out = jj(repo_dir, "log", "--no-graph", "-r", f"heads(::{a} & ::{b})",
                    "-T", 'commit_id ++ "\\n"', check=False)
    if len(out.splitlines()) != 1:
        return None
    return out.strip() if code == 0 and out.strip() else None


def changes(repo_dir, a, b):
    """[(status, old, new)] for exact JJ endpoints, including rename names."""
    out = jj(repo_dir, "diff", "--from", a, "--to", b, "--summary")[1]
    result = []
    for line in out.splitlines():
        letter, path = line.split(" ", 1)
        if letter in ("R", "C"):
            if "{" in path:
                prefix, rest = path.split("{", 1)
                pair, suffix = rest.rsplit("}", 1)
                old, new = (prefix + part + suffix for part in pair.split(" => ", 1))
            else:
                old, new = path.split(" => ", 1)
        else:
            old = new = path
        if any(c in old + new for c in '\\"\t\n'):
            raise GitError("ambiguous quoted or control-character path in summary")
        result.append((STATUS_NAMES.get(letter, letter), old, new))
    return result


def directories(repo_dir, commit):
    out = jj(repo_dir, "file", "list", "-r", commit)[1]
    return {d for path in out.splitlines() for d in ancestors(path)}


def ancestors(path):
    parent = posixpath.dirname(path)
    while parent:
        yield parent
        parent = posixpath.dirname(parent)


def overlap_reasons(pr_changes, base_changes, dirs_at_mb, dirs_at_base):
    pr_paths = sorted({p for _, old, new in pr_changes for p in (old, new)})

    by_path = {}
    by_parent = {}
    for change in base_changes:
        _, old, new = change
        for name in {old, new}:
            by_path.setdefault(name, []).append(change)
            parent = posixpath.dirname(name)
            if parent:
                by_parent.setdefault(parent, []).append(change)

    renamed_from = [old for status, old, _ in base_changes if status == "renamed"]

    reasons = set()
    for p in pr_paths:
        same = by_path.get(p, [])
        for status, _, new in same:
            reasons.add(("same-path", p, new, status))
        parent = posixpath.dirname(p)
        for change in by_parent.get(parent, []) if parent else []:
            if change not in same:
                status, _, new = change
                reasons.add(("sibling", p, new, status))
        for d in ancestors(p):
            if d in dirs_at_mb and d not in dirs_at_base:
                moved = any(old.startswith(d + "/") for old in renamed_from)
                reasons.add(("directory-gone", p, d, "renamed" if moved else "deleted"))
                break

    return [
        {"kind": k, "pr_path": p, "base_path": b, "base_status": s}
        for k, p, b, s in sorted(reasons)
    ]


def assess(repo_dir, remote, base, pr):
    result = {
        "base_oid": None,
        "head_oid": None,
        "merge_base": None,
        "overlap": "unknown",
        "reasons": [],
        "error": None,
    }
    try:
        base_oid, head_oid = fetch(repo_dir, remote, base, pr)
        result.update(base_oid=base_oid, head_oid=head_oid)

        mb = merge_base(repo_dir, base_oid, head_oid)
        if mb is None:
            result["error"] = "no unique common ancestor; investigate incomplete or unrelated history"
            return result
        result["merge_base"] = mb

        if mb == base_oid:
            result["overlap"] = False
            return result

        reasons = overlap_reasons(
            changes(repo_dir, mb, head_oid),
            changes(repo_dir, mb, base_oid),
            directories(repo_dir, mb),
            directories(repo_dir, base_oid),
        )
        result["reasons"] = reasons
        result["overlap"] = bool(reasons)
        return result
    except (GitError, OSError, subprocess.TimeoutExpired, ValueError, KeyError, TypeError) as e:
        result["error"] = str(e)
        return result


def main():
    p = argparse.ArgumentParser(prog="intake-overlap")
    p.add_argument("--repo-dir", required=True)
    p.add_argument("--remote", required=True)
    p.add_argument("--base", required=True)
    p.add_argument("--pr", type=int, required=True)
    args = p.parse_args()

    if args.pr <= 0:
        p.error("--pr must be a positive integer")
    if not args.remote or args.remote.startswith("-"):
        p.error("--remote must be a remote name or URL")
    if not args.base or args.base.startswith("-") or _BAD_BRANCH.search(args.base):
        p.error("--base must be a valid branch name")
    if not os.path.isdir(args.repo_dir):
        p.error("--repo-dir must be an existing directory")

    print(json.dumps(assess(args.repo_dir, args.remote, args.base, args.pr)))


if __name__ == "__main__":
    main()
