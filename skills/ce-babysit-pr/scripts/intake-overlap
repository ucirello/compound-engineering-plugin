#!/usr/bin/env python3
"""One-shot overlap check for ce-babysit-pr's stale-PR intake.

Answers "did the base move under this PR's paths since it branched off" from
freshly fetched refs:

  intake-overlap --repo-dir DIR --remote NAME --base BRANCH --pr N

Captures exact PR base/head OIDs through gh, fetches their named bookmarks with JJ,
takes their unique merge-base, and compares the PR's changed paths with the base's
changes since then. Overlap kinds:

  same-path       a base change (either rename name) is a PR path (either name)
  directory-gone  a PR path's ancestor directory existed at the merge-base and
                  is absent at the base tip (nearest such ancestor reported)
  sibling         a base change sits in the same non-root directory as a PR path

Prints one JSON object. "overlap" is true, false, or "unknown" when the question
cannot be answered (fetch failure, no merge-base); unknown sets "error" and still
exits 0. Only usage errors exit non-zero.
"""
import argparse
import json
import os
import posixpath
import re
import subprocess
import sys

FETCH_TIMEOUT_SECONDS = 300
GIT_TIMEOUT_SECONDS = 120

STATUS_NAMES = {
    "A": "added",
    "C": "copied",
    "D": "deleted",
    "M": "modified",
    "R": "renamed",
    "T": "type-changed",
}

_BAD_BRANCH = re.compile(r"[\x00-\x20\x7f~^:?*\[\\]|\.\.|@\{|//|/\.|\.lock$|^/|/$|\.$")


class GitError(Exception):
    pass


def jj(repo_dir, *args, timeout=GIT_TIMEOUT_SECONDS, check=True):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    try:
        r = subprocess.run(
            ["jj", "--no-pager", "--color=never", *args],
            cwd=os.path.abspath(repo_dir),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise GitError(f"jj {args[0]} timed out after {timeout}s")
    except OSError as e:
        raise GitError(f"could not run jj: {e}")
    out = r.stdout.decode("utf-8", errors="replace")
    if check and r.returncode != 0:
        err = r.stderr.decode("utf-8", errors="replace").strip()
        raise GitError(f"jj {args[0]} failed ({r.returncode}): {err}")
    return r.returncode, out


def fetch(repo_dir, remote, base, pr, extra=()):
    root = jj(repo_dir, "root")[1].strip()
    if os.path.realpath(root) != os.path.realpath(repo_dir):
        raise GitError("--repo-dir must be the absolute target workspace root")
    env = dict(os.environ, GIT_DIR=jj(repo_dir, "git", "root")[1].strip())
    remotes = jj(repo_dir, "git", "remote", "list")[1].splitlines()
    remote_map = dict(line.split(maxsplit=1) for line in remotes if len(line.split(maxsplit=1)) == 2)
    base_url = remote_map.get(remote)
    if not base_url:
        raise GitError("--remote must identify a registered base-repository remote")
    match = re.search(r"(?:https?://|ssh://(?:[^/@]+@)?|[^/@]+@)([^/:]+)[:/]([^/]+)/([^/]+?)(?:\.git)?/?$", base_url)
    if not match:
        raise GitError("cannot prove base repository identity from remote URL")
    host, owner, name = match.groups()
    r = subprocess.run(["gh", "pr", "view", str(pr), "--repo", f"{host}/{owner}/{name}", "--json",
                        "baseRefOid,baseRefName,headRefOid,headRefName,headRepositoryOwner,headRepository"],
                       cwd=root, env=env, capture_output=True, text=True,
                       timeout=FETCH_TIMEOUT_SECONDS)
    if r.returncode:
        raise GitError(f"exact PR identity lookup failed: {r.stderr.strip()}")
    try:
        metadata = json.loads(r.stdout)
        base_oid, head_oid = metadata["baseRefOid"], metadata["headRefOid"]
        if metadata["baseRefName"] != base:
            raise GitError("requested base does not match PR base")
        head_repo = metadata["headRepository"]["name"]
        head_owner = metadata["headRepositoryOwner"]["login"]
        head_branch = metadata["headRefName"]
    except (KeyError, TypeError, ValueError) as exc:
        raise GitError(f"incomplete exact PR identities: {exc}")
    jj(repo_dir, "git", "fetch", "--remote", remote, "--branch", f"exact:{base}",
       timeout=FETCH_TIMEOUT_SECONDS)
    base_oid = jj(repo_dir, "log", "--no-graph", "-r",
                  f'{json.dumps(base)}@{json.dumps(remote)}', "-T", "commit_id")[1].strip()
    head_remote = None
    for line in remotes:
        fields = line.split(maxsplit=1)
        if len(fields) == 2 and host in fields[1] and re.search(
                rf"[:/]{re.escape(head_owner)}/{re.escape(head_repo)}(?:\.git)?$", fields[1]):
            head_remote = fields[0]
            break
    if head_remote is None:
        # Retain the explicitly identified remote for recovery/reuse. Never replace
        # an existing remote or use another repository merely to obtain the OID.
        stem = f"babysit-intake-{pr}-head"
        head_remote = stem
        suffix = 2
        while head_remote in remote_map:
            head_remote = f"{stem}-{suffix}"
            suffix += 1
        jj(repo_dir, "git", "remote", "add", head_remote,
           f"https://{host}/{head_owner}/{head_repo}.git")
    jj(repo_dir, "git", "fetch", "--remote", head_remote,
       "--branch", f"exact:{head_branch}", timeout=FETCH_TIMEOUT_SECONDS)
    fetched_head = jj(repo_dir, "log", "--no-graph", "-r",
                      f'{json.dumps(head_branch)}@{json.dumps(head_remote)}',
                      "-T", "commit_id")[1].strip()
    if fetched_head != head_oid:
        raise GitError(f"PR head raced: captured {head_oid}, fetched {fetched_head}")
    # Captured OIDs, never whichever tip the fetch happens to return. If a fork's
    # object is unavailable, return unknown with the exact-ref failure.
    for oid in (base_oid, head_oid):
        if not re.fullmatch(r"[0-9a-fA-F]{40}|[0-9a-fA-F]{64}", oid):
            raise GitError("invalid captured PR OID")
        jj(repo_dir, "log", "--no-graph", "-r", oid, "-T", "commit_id")
    return base_oid, head_oid


def merge_base(repo_dir, a, b):
    code, out = jj(repo_dir, "log", "--no-graph", "-r", f"heads(::{a} & ::{b})",
                   "-T", 'commit_id ++ "\n"', check=False)
    if len(out.splitlines()) != 1:
        return None
    return out.strip() if code == 0 and out.strip() else None


def changes(repo_dir, a, b):
    """Exact tree delta; NUL-delimited template preserves unusual filenames."""
    out = jj(repo_dir, "diff", "--from", a, "--to", b,
             "-T", r'status_char ++ "\0" ++ source.path() ++ "\0" ++ target.path() ++ "\0"')[1]
    tokens = out.split("\0")
    result = []
    i = 0
    while i < len(tokens) and tokens[i]:
        letter = tokens[i][0]
        old, new = tokens[i + 1], tokens[i + 2]
        old, new = old or new, new or old
        i += 3
        result.append((STATUS_NAMES.get(letter, letter), old, new))
    return result


def directories(repo_dir, commit):
    out = jj(repo_dir, "file", "list", "-r", commit, "-T", r'path ++ "\0"')[1]
    return {d for p in out.split("\0") if p for d in ancestors(p)}


def ancestors(path):
    parent = posixpath.dirname(path)
    while parent:
        yield parent
        parent = posixpath.dirname(parent)


def overlap_reasons(pr_changes, base_changes, dirs_at_mb, dirs_at_base):
    pr_paths = sorted({p for _, old, new in pr_changes for p in (old, new)})

    by_path = {}
    by_parent = {}
    for change in base_changes:
        _, old, new = change
        for name in {old, new}:
            by_path.setdefault(name, []).append(change)
            parent = posixpath.dirname(name)
            if parent:
                by_parent.setdefault(parent, []).append(change)

    renamed_from = [old for status, old, _ in base_changes if status == "renamed"]

    reasons = set()
    for p in pr_paths:
        same = by_path.get(p, [])
        for status, _, new in same:
            reasons.add(("same-path", p, new, status))
        parent = posixpath.dirname(p)
        for change in by_parent.get(parent, []) if parent else []:
            if change not in same:
                status, _, new = change
                reasons.add(("sibling", p, new, status))
        for d in ancestors(p):
            if d in dirs_at_mb and d not in dirs_at_base:
                moved = any(old.startswith(d + "/") for old in renamed_from)
                reasons.add(("directory-gone", p, d, "renamed" if moved else "deleted"))
                break

    return [
        {"kind": k, "pr_path": p, "base_path": b, "base_status": s}
        for k, p, b, s in sorted(reasons)
    ]


def assess(repo_dir, remote, base, pr):
    result = {
        "base_oid": None,
        "head_oid": None,
        "merge_base": None,
        "overlap": "unknown",
        "reasons": [],
        "error": None,
    }
    try:
        base_oid, head_oid = fetch(repo_dir, remote, base, pr)
        result.update(base_oid=base_oid, head_oid=head_oid)

        mb = merge_base(repo_dir, base_oid, head_oid)
        if mb is None:
            result["error"] = "no unique merge-base; history may be unrelated, shallow, or ambiguous (JJ cannot unshallow here)"
            return result
        result["merge_base"] = mb

        if mb == base_oid:
            result["overlap"] = False
            return result

        reasons = overlap_reasons(
            changes(repo_dir, mb, head_oid),
            changes(repo_dir, mb, base_oid),
            directories(repo_dir, mb),
            directories(repo_dir, base_oid),
        )
        result["reasons"] = reasons
        result["overlap"] = bool(reasons)
        return result
    except (GitError, OSError, subprocess.TimeoutExpired) as e:
        result["error"] = str(e)
        return result


def main():
    p = argparse.ArgumentParser(prog="intake-overlap")
    p.add_argument("--repo-dir", required=True)
    p.add_argument("--remote", required=True)
    p.add_argument("--base", required=True)
    p.add_argument("--pr", type=int, required=True)
    args = p.parse_args()

    if args.pr <= 0:
        p.error("--pr must be a positive integer")
    if not args.remote or args.remote.startswith("-"):
        p.error("--remote must be a remote name or URL")
    if not args.base or args.base.startswith("-") or _BAD_BRANCH.search(args.base):
        p.error("--base must be a valid branch name")
    if not os.path.isdir(args.repo_dir):
        p.error("--repo-dir must be an existing directory")

    print(json.dumps(assess(args.repo_dir, args.remote, args.base, args.pr)))


if __name__ == "__main__":
    main()
