#!/usr/bin/env python3
"""One-shot overlap check for ce-babysit-pr's stale-PR intake.

Answers "did the base move under this PR's paths since it branched off" from
freshly fetched refs:

  intake-overlap --repo-dir DIR --remote NAME --base BRANCH \
                 (--head-remote NAME | --head-url URL) --head BRANCH --head-oid OID

Fetches the exact base and head bookmarks from their verified repositories,
requires the fetched head to match the PR observation, and compares both sides
with their merge base. Overlap kinds:

  same-path       a base change (either rename name) is a PR path (either name)
  directory-gone  a PR path's ancestor directory existed at the merge-base and
                  is absent at the base tip (nearest such ancestor reported)
  sibling         a base change sits in the same non-root directory as a PR path

Prints one JSON object. "overlap" is true, false, or "unknown" when the question
cannot be answered (fetch failure, no merge-base); unknown sets "error" and still
exits 0. Only usage errors exit non-zero.
"""
import argparse
import hashlib
import json
import os
import posixpath
import re
import subprocess
import sys
from urllib.parse import urlsplit

FETCH_TIMEOUT_SECONDS = 300
JJ_TIMEOUT_SECONDS = 120

_BAD_BRANCH = re.compile(r"[\x00-\x20\x7f~^:?*\[\\]|\.\.|@\{|//|/\.|\.lock$|^/|/$|\.$")
_OID = re.compile(r"(?:[0-9a-f]{40}|[0-9a-f]{64})")


class JJError(Exception):
    pass


def jj(repo_dir, *args, timeout=JJ_TIMEOUT_SECONDS, transport_config=()):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GCM_INTERACTIVE="never", LC_ALL="C")
    for key in ("GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE"):
        env.pop(key, None)
    if transport_config:
        # JJ reads the backend's process-scoped remote configuration. Do not edit the
        # user's remote table just to assess a contributor fork.
        try:
            index = int(env.get("GIT_CONFIG_COUNT", "0"))
            if index < 0:
                raise ValueError
        except ValueError:
            raise JJError("invalid process transport configuration count") from None
        for key, value in transport_config:
            env[f"GIT_CONFIG_KEY_{index}"] = key
            env[f"GIT_CONFIG_VALUE_{index}"] = value
            index += 1
        env["GIT_CONFIG_COUNT"] = str(index)
    try:
        r = subprocess.run(
            ["jj", "--ignore-working-copy", "--no-pager", "--color=never", *args],
            cwd=repo_dir,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise JJError(f"jj {args[0]} timed out after {timeout}s")
    except OSError as e:
        raise JJError(f"could not run jj: {e}")
    out = r.stdout.decode("utf-8", errors="replace")
    err = r.stderr.decode("utf-8", errors="replace").strip()
    if r.returncode != 0 or "No matching branches found" in err:
        raise JJError(f"jj {args[0]} failed ({r.returncode}): {err}")
    return out


def revision_ids(repo_dir, revset):
    return jj(repo_dir, "log", "--no-graph", "-r", revset,
              "-T", 'commit_id ++ "\\n"').splitlines()


def fetch(repo_dir, remote, branch, url=None):
    transport_config = ()
    if url:
        remote = "babysit-intake-" + hashlib.sha256(url.encode()).hexdigest()
        transport_config = ((f"remote.{remote}.url", url),
                            (f"credential.{url}.helper", "!gh auth git-credential"))
    jj(
        repo_dir, "--config=git.abandon-unreachable-commits=false", "git", "fetch",
        "--branch", f"exact:{branch}", "--remote", f"exact:{remote}",
        timeout=FETCH_TIMEOUT_SECONDS, transport_config=transport_config,
    )
    bookmark = f"{json.dumps(branch, ensure_ascii=False)}@{json.dumps(remote, ensure_ascii=False)}"
    ids = revision_ids(repo_dir, f"present({bookmark})")
    if len(ids) != 1 or not _OID.fullmatch(ids[0]):
        raise JJError(f"could not resolve fetched exact bookmark {branch}@{remote}")
    return ids[0]


def merge_base(repo_dir, a, b):
    ids = revision_ids(repo_dir, f"heads(::{a} & ::{b}) ~ root()")
    return ids[0] if len(ids) == 1 else None


def changes(repo_dir, a, b):
    """[(status, old, new)] from JJ's exact tree diff."""
    out = jj(repo_dir, "diff", "--from", a, "--to", b, "-T",
             'status ++ "\\0" ++ source.path() ++ "\\0" ++ target.path() ++ "\\0"'
             ' ++ source.file_type() ++ "\\0" ++ target.file_type() ++ "\\0"')
    tokens = out.split("\0")[:-1]
    result = []
    for i in range(0, len(tokens), 5):
        status, old, new, before, after = tokens[i:i + 5]
        if status == "modified" and before != after:
            status = "type-changed"
        result.append((status, old, new))
    return result


def directories(repo_dir, commit):
    out = jj(repo_dir, "file", "list", "-r", commit, "-T", 'path ++ "\\0"')
    return {directory for path in out.split("\0") for directory in ancestors(path)}


def ancestors(path):
    parent = posixpath.dirname(path)
    while parent:
        yield parent
        parent = posixpath.dirname(parent)


def overlap_reasons(pr_changes, base_changes, dirs_at_mb, dirs_at_base):
    pr_paths = sorted({p for _, old, new in pr_changes for p in (old, new)})

    by_path = {}
    by_parent = {}
    for change in base_changes:
        _, old, new = change
        for name in {old, new}:
            by_path.setdefault(name, []).append(change)
            parent = posixpath.dirname(name)
            if parent:
                by_parent.setdefault(parent, []).append(change)

    renamed_from = [old for status, old, _ in base_changes if status == "renamed"]

    reasons = set()
    for p in pr_paths:
        same = by_path.get(p, [])
        for status, _, new in same:
            reasons.add(("same-path", p, new, status))
        parent = posixpath.dirname(p)
        for change in by_parent.get(parent, []) if parent else []:
            if change not in same:
                status, _, new = change
                reasons.add(("sibling", p, new, status))
        for d in ancestors(p):
            if d in dirs_at_mb and d not in dirs_at_base:
                moved = any(old.startswith(d + "/") for old in renamed_from)
                reasons.add(("directory-gone", p, d, "renamed" if moved else "deleted"))
                break

    return [
        {"kind": k, "pr_path": p, "base_path": b, "base_status": s}
        for k, p, b, s in sorted(reasons)
    ]


def assess(repo_dir, remote, base, head_remote, head, expected_head, head_url=None):
    result = {
        "base_oid": None,
        "head_oid": None,
        "merge_base": None,
        "overlap": "unknown",
        "reasons": [],
        "error": None,
    }
    try:
        base_oid = fetch(repo_dir, remote, base)
        result["base_oid"] = base_oid
        head_oid = fetch(repo_dir, head_remote, head, head_url)
        result["head_oid"] = head_oid
        if head_oid != expected_head:
            raise JJError(f"PR head moved: expected {expected_head}, fetched {head_oid}")

        mb = merge_base(repo_dir, base_oid, head_oid)
        if mb is None:
            result["error"] = "no unique merge-base between base and PR head"
            return result
        result["merge_base"] = mb

        if mb == base_oid:
            result["overlap"] = False
            return result

        reasons = overlap_reasons(
            changes(repo_dir, mb, head_oid),
            changes(repo_dir, mb, base_oid),
            directories(repo_dir, mb),
            directories(repo_dir, base_oid),
        )
        result["reasons"] = reasons
        result["overlap"] = bool(reasons)
        return result
    except JJError as e:
        result["error"] = str(e)
        return result


def main():
    p = argparse.ArgumentParser(prog="intake-overlap")
    p.add_argument("--repo-dir", required=True)
    p.add_argument("--remote", required=True)
    p.add_argument("--base", required=True)
    head_source = p.add_mutually_exclusive_group(required=True)
    head_source.add_argument("--head-remote")
    head_source.add_argument("--head-url")
    p.add_argument("--head", required=True)
    p.add_argument("--head-oid", required=True)
    args = p.parse_args()

    remotes = [("--remote", args.remote)]
    if args.head_remote is not None:
        remotes.append(("--head-remote", args.head_remote))
    for name, value in remotes:
        if not value or value.startswith("-") or any(ord(c) < 32 for c in value):
            p.error(f"{name} must be an exact named JJ remote")
    for name, value in (("--base", args.base), ("--head", args.head)):
        if not value or value.startswith("-") or _BAD_BRANCH.search(value):
            p.error(f"{name} must be a valid branch name")
    if not _OID.fullmatch(args.head_oid):
        p.error("--head-oid must be a full commit ID")
    if args.head_url is not None:
        try:
            url = urlsplit(args.head_url)
            valid = (url.scheme == "https" and url.hostname and url.username is None
                     and url.password is None and not url.query and not url.fragment
                     and re.fullmatch(r"/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\.git", url.path))
        except ValueError:
            valid = False
        if not valid:
            p.error("--head-url must be the verified HTTPS clone URL without credentials")
    if not os.path.isabs(args.repo_dir) or not os.path.isdir(args.repo_dir):
        p.error("--repo-dir must be an existing absolute workspace root")

    print(json.dumps(assess(args.repo_dir, args.remote, args.base, args.head_remote,
                            args.head, args.head_oid, args.head_url)))


if __name__ == "__main__":
    main()
