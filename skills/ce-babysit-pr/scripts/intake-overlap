#!/usr/bin/env python3
"""One-shot overlap check for ce-babysit-pr's stale-PR intake.

Answers "did the base move under this PR's paths since it branched off" from
freshly fetched refs:

  intake-overlap --repo-dir DIR --remote NAME --base BRANCH --pr N

Fetches the exact base bookmark and verified PR head repository/bookmark using JJ,
takes their unique common ancestor, and compares the PR's changed paths with the base's
changes since then. Overlap kinds:

  same-path       a base change (either rename name) is a PR path (either name)
  directory-gone  a PR path's ancestor directory existed at the merge-base and
                  is absent at the base tip (nearest such ancestor reported)
  sibling         a base change sits in the same non-root directory as a PR path

Prints one JSON object. "overlap" is true, false, or "unknown" when the question
cannot be answered (fetch failure, no merge-base); unknown sets "error" and still
exits 0. Only usage errors exit non-zero.
"""
import argparse
import json
import os
import posixpath
import re
import subprocess
import sys

FETCH_TIMEOUT_SECONDS = 300
GIT_TIMEOUT_SECONDS = 120

STATUS_NAMES = {
    "A": "added",
    "C": "copied",
    "D": "deleted",
    "M": "modified",
    "R": "renamed",
    "T": "type-changed",
}

_BAD_BRANCH = re.compile(r"[\x00-\x20\x7f~^:?*\[\\]|\.\.|@\{|//|/\.|\.lock$|^/|/$|\.$")


class GitError(Exception):
    pass


def git(repo_dir, *args, timeout=GIT_TIMEOUT_SECONDS, check=True):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    try:
        r = subprocess.run(
            ["jj", *args], cwd=os.path.abspath(repo_dir),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise GitError(f"jj {args[0]} timed out after {timeout}s")
    except OSError as e:
        raise GitError(f"could not run jj: {e}")
    out = r.stdout.decode("utf-8", errors="replace")
    if check and r.returncode != 0:
        err = r.stderr.decode("utf-8", errors="replace").strip()
        raise GitError(f"jj {args[0]} failed ({r.returncode}): {err}")
    return r.returncode, out


def fetch(repo_dir, remote, base, pr, extra=()):
    # Never substitute another ref when the requested source is unavailable.
    git(repo_dir, "git", "fetch", "--remote", remote,
        timeout=FETCH_TIMEOUT_SECONDS)
    remotes = dict(line.split(None, 1) for line in
                   git(repo_dir, "git", "remote", "list")[1].splitlines())
    if remote not in remotes:
        raise GitError("base remote is not configured")
    info = api(repo_dir, ["pr", "view", str(pr), "--repo", remotes[remote], "--json",
                          "baseRefName,baseRefOid,headRefOid,headRefName,headRepository,headRepositoryOwner"])
    if info["baseRefName"] != base:
        raise GitError("PR base differs from requested base")
    base_oid = git(repo_dir, "log", "--no-graph", "-r", f'{base}@{remote}', "-T", "commit_id")[1].strip()
    head_oid = info["headRefOid"]
    head_repo = info.get("headRepository") or {}
    owner = (info.get("headRepositoryOwner") or {}).get("login")
    if not owner or not head_repo.get("name"):
        raise GitError("PR head repository is unavailable")
    # Keep the base host (including Enterprise); never query a fork's PR namespace.
    base_url = remotes[remote]
    host_match = re.search(r"(?:https?://|@)([^/:]+)", base_url)
    if not host_match:
        raise GitError("cannot prove remote host")
    url = f'https://{host_match.group(1)}/{owner}/{head_repo["name"]}.git'
    head_remote = f"babysit-pr-{pr}-head"
    if head_remote in remotes and remotes[head_remote] != url:
        raise GitError("owned head remote name collision")
    if head_remote not in remotes:
        git(repo_dir, "git", "remote", "add", head_remote, url)
    git(repo_dir, "git", "fetch", "--remote", head_remote, "--branch",
        info["headRefName"], timeout=FETCH_TIMEOUT_SECONDS)
    observed = git(repo_dir, "log", "--no-graph", "-r",
                   f'{info["headRefName"]}@{head_remote}', "-T", "commit_id")[1].strip()
    if observed != head_oid:
        raise GitError("head moved during fetch")
    git(repo_dir, "log", "--no-graph", "-r", head_oid, "-T", "commit_id")
    return base_oid, head_oid


def api(repo_dir, args):
    root = git(repo_dir, "git", "root")[1].strip()
    env = dict(os.environ, GIT_DIR=root)
    result = subprocess.run(["gh", *args], cwd=os.path.abspath(repo_dir), env=env,
                            capture_output=True, text=True, timeout=120)
    if result.returncode:
        raise GitError(result.stderr.strip())
    return json.loads(result.stdout)


def merge_base(repo_dir, a, b):
    code, out = git(repo_dir, "log", "--no-graph", "-r", f"heads(::{a} & ::{b})", "-T", 'commit_id ++ "\\n"', check=False)
    if len(out.splitlines()) != 1:
        return None
    return out.strip() if code == 0 and out.strip() else None


def changes(repo_dir, a, b):
    """Exact endpoint changes; retain both names for rename/copy overlap."""
    out = git(repo_dir, "diff", "--from", a, "--to", b, "--summary", "--color", "never")[1]
    result = []
    for line in out.splitlines():
        letter, path = line.split(" ", 1)
        old = new = path
        if letter in ("R", "C"):
            match = re.fullmatch(r"(.*)\{(.*?) => (.*?)\}(.*)", path)
            if not match:
                raise GitError("unrecognized rename summary; overlap unknown")
            prefix, before, after, suffix = match.groups()
            old, new = prefix + before + suffix, prefix + after + suffix
        result.append((STATUS_NAMES.get(letter, letter), old, new))
    return result


def directories(repo_dir, commit):
    out = git(repo_dir, "file", "list", "-r", commit)[1]
    return {d for path in out.splitlines() for d in ancestors(path)}


def ancestors(path):
    parent = posixpath.dirname(path)
    while parent:
        yield parent
        parent = posixpath.dirname(parent)


def overlap_reasons(pr_changes, base_changes, dirs_at_mb, dirs_at_base):
    pr_paths = sorted({p for _, old, new in pr_changes for p in (old, new)})

    by_path = {}
    by_parent = {}
    for change in base_changes:
        _, old, new = change
        for name in {old, new}:
            by_path.setdefault(name, []).append(change)
            parent = posixpath.dirname(name)
            if parent:
                by_parent.setdefault(parent, []).append(change)

    renamed_from = [old for status, old, _ in base_changes if status == "renamed"]

    reasons = set()
    for p in pr_paths:
        same = by_path.get(p, [])
        for status, _, new in same:
            reasons.add(("same-path", p, new, status))
        parent = posixpath.dirname(p)
        for change in by_parent.get(parent, []) if parent else []:
            if change not in same:
                status, _, new = change
                reasons.add(("sibling", p, new, status))
        for d in ancestors(p):
            if d in dirs_at_mb and d not in dirs_at_base:
                moved = any(old.startswith(d + "/") for old in renamed_from)
                reasons.add(("directory-gone", p, d, "renamed" if moved else "deleted"))
                break

    return [
        {"kind": k, "pr_path": p, "base_path": b, "base_status": s}
        for k, p, b, s in sorted(reasons)
    ]


def assess(repo_dir, remote, base, pr):
    result = {
        "base_oid": None,
        "head_oid": None,
        "merge_base": None,
        "overlap": "unknown",
        "reasons": [],
        "error": None,
    }
    try:
        base_oid, head_oid = fetch(repo_dir, remote, base, pr)
        result.update(base_oid=base_oid, head_oid=head_oid)

        mb = merge_base(repo_dir, base_oid, head_oid)
        if mb is None:
            result["error"] = "no unique merge-base; history may be incomplete"
            return result
        result["merge_base"] = mb

        if mb == base_oid:
            result["overlap"] = False
            return result

        reasons = overlap_reasons(
            changes(repo_dir, mb, head_oid),
            changes(repo_dir, mb, base_oid),
            directories(repo_dir, mb),
            directories(repo_dir, base_oid),
        )
        result["reasons"] = reasons
        result["overlap"] = bool(reasons)
        return result
    except (GitError, OSError, ValueError, KeyError, subprocess.TimeoutExpired) as e:
        result["error"] = str(e)
        return result


def main():
    p = argparse.ArgumentParser(prog="intake-overlap")
    p.add_argument("--repo-dir", required=True)
    p.add_argument("--remote", required=True)
    p.add_argument("--base", required=True)
    p.add_argument("--pr", type=int, required=True)
    args = p.parse_args()

    if args.pr <= 0:
        p.error("--pr must be a positive integer")
    if not args.remote or args.remote.startswith("-"):
        p.error("--remote must be a remote name or URL")
    if not args.base or args.base.startswith("-") or _BAD_BRANCH.search(args.base):
        p.error("--base must be a valid branch name")
    if not os.path.isdir(args.repo_dir):
        p.error("--repo-dir must be an existing directory")

    print(json.dumps(assess(args.repo_dir, args.remote, args.base, args.pr)))


if __name__ == "__main__":
    main()
