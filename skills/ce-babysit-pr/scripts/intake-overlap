#!/usr/bin/env python3
"""One-shot overlap check for ce-babysit-pr's stale-PR intake.

Answers "did the base move under this PR's paths since it branched off" from
freshly fetched refs:

  intake-overlap --repo-dir DIR --remote NAME --base BRANCH --pr N

Fetches the base branch and the PR's verified head repository/branch with JJ,
takes their merge-base, and compares the PR's changed paths with the base's
changes since then. Overlap kinds:

  same-path       a base change (either rename name) is a PR path (either name)
  directory-gone  a PR path's ancestor directory existed at the merge-base and
                  is absent at the base tip (nearest such ancestor reported)
  sibling         a base change sits in the same non-root directory as a PR path

Prints one JSON object. "overlap" is true, false, or "unknown" when the question
cannot be answered (fetch failure, no merge-base); unknown sets "error" and still
exits 0. Only usage errors exit non-zero.
"""
import argparse
import json
import os
import posixpath
import re
import subprocess
import sys

FETCH_TIMEOUT_SECONDS = 300
GIT_TIMEOUT_SECONDS = 120

STATUS_NAMES = {
    "A": "added",
    "C": "copied",
    "D": "deleted",
    "M": "modified",
    "R": "renamed",
    "T": "type-changed",
}

_BAD_BRANCH = re.compile(r"[\x00-\x20\x7f~^:?*\[\\]|\.\.|@\{|//|/\.|\.lock$|^/|/$|\.$")


class GitError(Exception):
    pass


def jj(repo_dir, *args, timeout=GIT_TIMEOUT_SECONDS, check=True):
    env = {key: value for key, value in os.environ.items()
           if not key.startswith("GIT_")}
    env["GIT_TERMINAL_PROMPT"] = "0"
    try:
        root = subprocess.run(
            ["jj", "workspace", "root"], cwd=os.path.abspath(repo_dir), env=env,
            capture_output=True, text=True, timeout=timeout, check=True,
        ).stdout.strip()
        r = subprocess.run(
            ["jj", *args], cwd=root,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise GitError(f"jj {args[0]} timed out after {timeout}s")
    except OSError as e:
        raise GitError(f"could not run jj: {e}")
    except subprocess.CalledProcessError as e:
        raise GitError(f"cannot resolve workspace root: {e.stderr.strip()}")
    out = r.stdout.decode("utf-8", errors="replace")
    if check and r.returncode != 0:
        err = r.stderr.decode("utf-8", errors="replace").strip()
        raise GitError(f"jj {args[0]} failed ({r.returncode}): {err}")
    return r.returncode, out


def refs_for(pr):
    prefix = f"refs/ce-babysit/intake/{pr}"
    return f"{prefix}/base", f"{prefix}/head"


def fetch(repo_dir, remote, base, pr, extra=()):
    # Resolve the exact PR mirror through its base repository, not the checkout's origin.
    url = jj(repo_dir, "git", "remote", "list")[1]
    matches = [line.split(maxsplit=1)[1] for line in url.splitlines()
               if line.split(maxsplit=1)[0] == remote]
    if len(matches) != 1:
        raise GitError(f"cannot resolve exact configured remote {remote}")
    env = {key: value for key, value in os.environ.items()
           if not key.startswith("GIT_")}
    env["GIT_DIR"] = jj(repo_dir, "git", "root")[1].strip()
    workspace_root = jj(repo_dir, "workspace", "root")[1].strip()
    base_url = matches[0]
    remote_match = re.fullmatch(r"(?:https?://|ssh://(?:[^@/]+@)?|[^@/]+@)([^/:]+)[:/]([^/]+)/(.+?)(?:\.git)?/?", base_url)
    if not remote_match:
        raise GitError("cannot resolve verified remote host and repository")
    base_selector = "/".join(remote_match.groups())
    result = subprocess.run(["gh", "pr", "view", str(pr), "--repo", base_selector,
                             "--json", "headRefOid,headRefName,headRepository,headRepositoryOwner"],
                            cwd=workspace_root, env=env,
                            capture_output=True, text=True, timeout=120)
    if result.returncode:
        raise GitError(f"cannot resolve exact PR head: {result.stderr.strip()}")
    try:
        metadata = json.loads(result.stdout)
        head = metadata["headRefOid"]
        branch = metadata["headRefName"]
        owner = metadata["headRepositoryOwner"]["login"]
        name = metadata["headRepository"]["name"]
        if not re.fullmatch(r"[0-9a-fA-F]{40,64}", head) or not branch or _BAD_BRANCH.search(branch):
            raise ValueError("invalid exact head identity")
    except (KeyError, TypeError, ValueError) as error:
        raise GitError(f"cannot resolve exact PR head: {error}")
    # Read the host from the verified base URL; preserve Enterprise host identity.
    head_url = f"https://{remote_match[1]}/{owner}/{name}.git"
    head_remote = f"babysit-intake-{pr}"
    remotes = dict(line.split(maxsplit=1) for line in url.splitlines() if line.strip())
    suffix = 2
    while head_remote in remotes and remotes[head_remote] != head_url:
        head_remote = f"babysit-intake-{pr}-{suffix}"
        suffix += 1
    if head_remote not in remotes:
        jj(repo_dir, "git", "remote", "add", head_remote, head_url)
    # Keep this deterministic source remote for cache reuse and recovery; never overwrite it.
    jj(repo_dir, "git", "fetch", "--remote", f"exact:{remote}", "--branch", f"exact:{base}",
       timeout=FETCH_TIMEOUT_SECONDS)
    jj(repo_dir, "git", "fetch", "--remote", head_remote, "--branch", f"exact:{branch}",
       timeout=FETCH_TIMEOUT_SECONDS)
    base_rev = f"{json.dumps(base)}@{json.dumps(remote)}"
    base_oid = jj(repo_dir, "log", "--no-graph", "-r", base_rev, "-T", "commit_id")[1].strip()
    verified_head = jj(repo_dir, "log", "--no-graph", "-r", head, "-T", "commit_id")[1].strip()
    fetched_head = jj(repo_dir, "log", "--no-graph", "-r",
                      f"{json.dumps(branch)}@{json.dumps(head_remote)}", "-T", "commit_id")[1].strip()
    if verified_head != head or fetched_head != head:
        raise GitError("fetched PR mirror does not resolve the verified head")
    return base_oid, head


def merge_base(repo_dir, a, b):
    code, out = jj(repo_dir, "log", "--no-graph", "-r", f"heads(::{a} & ::{b})", "-T", 'commit_id ++ "\\n"', check=False)
    values = out.splitlines()
    return values[0] if code == 0 and len(values) == 1 else None


def changes(repo_dir, a, b):
    """Preserve both names of JJ-detected copies and renames."""
    out = jj(repo_dir, "diff", "--from", a, "--to", b, "--summary")[1]
    result = []
    for line in out.splitlines():
        letter, path = line.split(" ", 1)
        if path.startswith('"') or "\\" in path:
            raise GitError("quoted/escaped path cannot be interpreted safely; overlap unknown")
        old = new = path
        if letter in ("R", "C"):
            if "{" in path and "}" in path:
                prefix, rest = path.split("{", 1)
                middle, suffix = rest.rsplit("}", 1)
                before, after = middle.split(" => ", 1)
                old, new = prefix + before + suffix, prefix + after + suffix
            else:
                old, new = path.split(" => ", 1)
        result.append((STATUS_NAMES.get(letter, letter), old, new))
    return result


def directories(repo_dir, commit):
    out = jj(repo_dir, "file", "list", "-r", commit)[1]
    if any(path.startswith('"') or "\\" in path for path in out.splitlines()):
        raise GitError("quoted/escaped tree path cannot be interpreted safely; overlap unknown")
    return {d for path in out.splitlines() for d in ancestors(path)}


def ancestors(path):
    parent = posixpath.dirname(path)
    while parent:
        yield parent
        parent = posixpath.dirname(parent)


def overlap_reasons(pr_changes, base_changes, dirs_at_mb, dirs_at_base):
    pr_paths = sorted({p for _, old, new in pr_changes for p in (old, new)})

    by_path = {}
    by_parent = {}
    for change in base_changes:
        _, old, new = change
        for name in {old, new}:
            by_path.setdefault(name, []).append(change)
            parent = posixpath.dirname(name)
            if parent:
                by_parent.setdefault(parent, []).append(change)

    renamed_from = [old for status, old, _ in base_changes if status == "renamed"]

    reasons = set()
    for p in pr_paths:
        same = by_path.get(p, [])
        for status, _, new in same:
            reasons.add(("same-path", p, new, status))
        parent = posixpath.dirname(p)
        for change in by_parent.get(parent, []) if parent else []:
            if change not in same:
                status, _, new = change
                reasons.add(("sibling", p, new, status))
        for d in ancestors(p):
            if d in dirs_at_mb and d not in dirs_at_base:
                moved = any(old.startswith(d + "/") for old in renamed_from)
                reasons.add(("directory-gone", p, d, "renamed" if moved else "deleted"))
                break

    return [
        {"kind": k, "pr_path": p, "base_path": b, "base_status": s}
        for k, p, b, s in sorted(reasons)
    ]


def assess(repo_dir, remote, base, pr):
    result = {
        "base_oid": None,
        "head_oid": None,
        "merge_base": None,
        "overlap": "unknown",
        "reasons": [],
        "error": None,
    }
    try:
        base_oid, head_oid = fetch(repo_dir, remote, base, pr)
        result.update(base_oid=base_oid, head_oid=head_oid)

        mb = merge_base(repo_dir, base_oid, head_oid)
        if mb is None:
            result["error"] = "no unique merge-base in fetched history; overlap remains unknown"
            return result
        result["merge_base"] = mb

        if mb == base_oid:
            result["overlap"] = False
            return result

        reasons = overlap_reasons(
            changes(repo_dir, mb, head_oid),
            changes(repo_dir, mb, base_oid),
            directories(repo_dir, mb),
            directories(repo_dir, base_oid),
        )
        result["reasons"] = reasons
        result["overlap"] = bool(reasons)
        return result
    except (GitError, OSError, subprocess.TimeoutExpired, ValueError) as e:
        result["error"] = str(e)
        return result


def main():
    p = argparse.ArgumentParser(prog="intake-overlap")
    p.add_argument("--repo-dir", required=True)
    p.add_argument("--remote", required=True)
    p.add_argument("--base", required=True)
    p.add_argument("--pr", type=int, required=True)
    args = p.parse_args()

    if args.pr <= 0:
        p.error("--pr must be a positive integer")
    if not args.remote or args.remote.startswith("-"):
        p.error("--remote must be a remote name or URL")
    if not args.base or args.base.startswith("-") or _BAD_BRANCH.search(args.base):
        p.error("--base must be a valid branch name")
    if not os.path.isdir(args.repo_dir):
        p.error("--repo-dir must be an existing directory")

    print(json.dumps(assess(args.repo_dir, args.remote, args.base, args.pr)))


if __name__ == "__main__":
    main()
