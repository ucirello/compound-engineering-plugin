#!/usr/bin/env bash

set -e

if [ $# -eq 0 ]; then
    echo "Usage: resolve-pr-thread THREAD_ID"
    echo "Example: resolve-pr-thread PRRT_kwDOABC123"
    exit 1
fi

THREAD_ID=$1

# Pair every gh call with GIT_DIR from the colocated Git dir. Prefer a
# caller-supplied GIT_DIR; otherwise resolve it from jj.
if [ -z "${GIT_DIR:-}" ]; then
    _git_dir=$(jj git root 2>/dev/null || true)
    if [ -n "$_git_dir" ]; then
        export GIT_DIR="$_git_dir"
    fi
fi

gh api graphql -f threadId="$THREAD_ID" -f query='
mutation ResolveReviewThread($threadId: ID!) {
  resolveReviewThread(input: {threadId: $threadId}) {
    thread {
      id
      isResolved
      path
      line
    }
  }
}'
