#!/usr/bin/env python3
"""One-shot overlap check for ce-babysit-pr's stale-PR intake.

Answers "did the base move under this PR's paths since it branched off" from
freshly fetched refs:

  intake-overlap --repo-dir DIR --remote NAME --base BRANCH --pr N

Fetches the exact base and PR head bookmarks through JJ,
takes their merge-base, and compares the PR's changed paths with the base's
changes since then. Overlap kinds:

  same-path       a base change (either rename name) is a PR path (either name)
  directory-gone  a PR path's ancestor directory existed at the merge-base and
                  is absent at the base tip (nearest such ancestor reported)
  sibling         a base change sits in the same non-root directory as a PR path

Prints one JSON object. "overlap" is true, false, or "unknown" when the question
cannot be answered (fetch failure, no merge-base); unknown sets "error" and still
exits 0. Only usage errors exit non-zero.
"""
import argparse
import json
import os
import posixpath
import re
import subprocess
import sys

FETCH_TIMEOUT_SECONDS = 300
GIT_TIMEOUT_SECONDS = 120

STATUS_NAMES = {
    "A": "added",
    "C": "copied",
    "D": "deleted",
    "M": "modified",
    "R": "renamed",
    "T": "type-changed",
}

_BAD_BRANCH = re.compile(r"[\x00-\x20\x7f~^:?*\[\\]|\.\.|@\{|//|/\.|\.lock$|^/|/$|\.$")


class GitError(Exception):
    pass


def jj(repo_dir, *args, timeout=GIT_TIMEOUT_SECONDS, check=True):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")
    try:
        r = subprocess.run(
            ["jj", "--color=never", *args],
            cwd=os.path.abspath(repo_dir),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise GitError(f"jj {args[0]} timed out after {timeout}s")
    except OSError as e:
        raise GitError(f"could not run jj: {e}")
    out = r.stdout.decode("utf-8", errors="replace")
    if check and r.returncode != 0:
        err = r.stderr.decode("utf-8", errors="replace").strip()
        raise GitError(f"jj {args[0]} failed ({r.returncode}): {err}")
    return r.returncode, out


def refs_for(pr):
    prefix = f"refs/ce-babysit/intake/{pr}"
    return f"{prefix}/base", f"{prefix}/head"


def fetch(repo_dir, remote, base, pr, extra=()):
    jj(repo_dir, "git", "fetch", "--remote", remote, "--branch", base,
       timeout=FETCH_TIMEOUT_SECONDS)
    # Resolve the PR head through gh, then fetch its exact source bookmark.
    env = dict(os.environ, GIT_DIR=jj(repo_dir, "git", "root")[1].strip())
    response = subprocess.run(
        ["gh", "pr", "view", str(pr), "--json", "headRefName,headRefOid,headRepository,headRepositoryOwner,isCrossRepository"],
        cwd=os.path.abspath(repo_dir), env=env, capture_output=True, text=True,
        timeout=FETCH_TIMEOUT_SECONDS, check=True)
    data = json.loads(response.stdout)
    if data.get("isCrossRepository"):
        raise GitError("exact PR head is in another repository; fetch requires a verified configured head remote")
    head = data["headRefName"]
    jj(repo_dir, "git", "fetch", "--remote", remote, "--branch", head,
       timeout=FETCH_TIMEOUT_SECONDS)
    def oid(bookmark):
        return jj(repo_dir, "log", "--no-graph", "-r", bookmark,
                  "-T", "commit_id ++ '\\n'")[1].strip()
    base_oid = oid(f"remote_bookmarks(exact:{json.dumps(base)}, remote=exact:{json.dumps(remote)})")
    head_oid = oid(f"remote_bookmarks(exact:{json.dumps(head)}, remote=exact:{json.dumps(remote)})")
    if head_oid != data["headRefOid"]:
        raise GitError("fetched head does not match exact PR head")
    return base_oid, head_oid


def merge_base(repo_dir, a, b):
    code, out = jj(repo_dir, "log", "--no-graph", "-r", f"heads(::({a}) & ::({b}))",
                   "-T", "commit_id ++ '\\n'", check=False)
    candidates = out.splitlines()
    return candidates[0] if code == 0 and len(candidates) == 1 else None


def changes(repo_dir, a, b):
    """Conservative changed paths; renames are represented by both endpoints."""
    out = jj(repo_dir, "diff", "--from", a, "--to", b, "--summary")[1]
    result = []
    for line in out.splitlines():
        letter, sep, path = line.partition(" ")
        if (not sep or letter not in STATUS_NAMES or letter in ("R", "C")
                or path.startswith('"') or " => " in path):
            raise GitError("ambiguous JJ summary path/rename; overlap unknown")
        result.append((STATUS_NAMES[letter], path, path))
    return result


def directories(repo_dir, commit):
    out = jj(repo_dir, "file", "list", "-r", commit)[1]
    return {d for path in out.splitlines() for d in ancestors(path)}


def ancestors(path):
    parent = posixpath.dirname(path)
    while parent:
        yield parent
        parent = posixpath.dirname(parent)


def overlap_reasons(pr_changes, base_changes, dirs_at_mb, dirs_at_base):
    pr_paths = sorted({p for _, old, new in pr_changes for p in (old, new)})

    by_path = {}
    by_parent = {}
    for change in base_changes:
        _, old, new = change
        for name in {old, new}:
            by_path.setdefault(name, []).append(change)
            parent = posixpath.dirname(name)
            if parent:
                by_parent.setdefault(parent, []).append(change)

    renamed_from = [old for status, old, _ in base_changes if status == "renamed"]

    reasons = set()
    for p in pr_paths:
        same = by_path.get(p, [])
        for status, _, new in same:
            reasons.add(("same-path", p, new, status))
        parent = posixpath.dirname(p)
        for change in by_parent.get(parent, []) if parent else []:
            if change not in same:
                status, _, new = change
                reasons.add(("sibling", p, new, status))
        for d in ancestors(p):
            if d in dirs_at_mb and d not in dirs_at_base:
                moved = any(old.startswith(d + "/") for old in renamed_from)
                reasons.add(("directory-gone", p, d, "renamed" if moved else "deleted"))
                break

    return [
        {"kind": k, "pr_path": p, "base_path": b, "base_status": s}
        for k, p, b, s in sorted(reasons)
    ]


def assess(repo_dir, remote, base, pr):
    result = {
        "base_oid": None,
        "head_oid": None,
        "merge_base": None,
        "overlap": "unknown",
        "reasons": [],
        "error": None,
    }
    try:
        base_oid, head_oid = fetch(repo_dir, remote, base, pr)
        result.update(base_oid=base_oid, head_oid=head_oid)

        mb = merge_base(repo_dir, base_oid, head_oid)
        if mb is None:
            result["error"] = "no unique available common ancestor; overlap unknown"
            return result
        result["merge_base"] = mb

        if mb == base_oid:
            result["overlap"] = False
            return result

        reasons = overlap_reasons(
            changes(repo_dir, mb, head_oid),
            changes(repo_dir, mb, base_oid),
            directories(repo_dir, mb),
            directories(repo_dir, base_oid),
        )
        result["reasons"] = reasons
        result["overlap"] = bool(reasons)
        return result
    except (GitError, subprocess.SubprocessError, OSError, ValueError, KeyError) as e:
        result["error"] = str(e)
        return result


def main():
    p = argparse.ArgumentParser(prog="intake-overlap")
    p.add_argument("--repo-dir", required=True)
    p.add_argument("--remote", required=True)
    p.add_argument("--base", required=True)
    p.add_argument("--pr", type=int, required=True)
    args = p.parse_args()

    if args.pr <= 0:
        p.error("--pr must be a positive integer")
    if not args.remote or args.remote.startswith("-"):
        p.error("--remote must be a remote name or URL")
    if not args.base or args.base.startswith("-") or _BAD_BRANCH.search(args.base):
        p.error("--base must be a valid branch name")
    if not os.path.isdir(args.repo_dir):
        p.error("--repo-dir must be an existing directory")
    if not os.path.isabs(args.repo_dir):
        p.error("--repo-dir must be the verified absolute JJ workspace root")

    print(json.dumps(assess(args.repo_dir, args.remote, args.base, args.pr)))


if __name__ == "__main__":
    main()
